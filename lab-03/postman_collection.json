    {
      "name": "3. POST - Create Book & Validation",
      "item": [
        {
          "name": "POST /books (Success - 201 Created)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Site Reliability Engineering\",\n  \"author\": \"Betsy Beyer\",\n  \"price\": 39.95\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Returns created book with generated ID\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('book');",
                  "    pm.expect(json.book.title).to.eql('Site Reliability Engineering');",
                  "    pm.environment.set('createdBookId', json.book.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
